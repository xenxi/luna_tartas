{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": { "mode": { "type": "string", "const": "made-to-order" } },
      "required": ["mode"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "const": "stock" },
        "quantity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["mode", "quantity"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": { "mode": { "type": "string", "const": "unavailable" } },
      "required": ["mode"],
      "additionalProperties": false
    }
  ],
  "$id": "https://lunatartas.es/schemas/inventory.schema.json",
  "title": "Luna Tartas inventory source contract",
  "x-contractVersion": "2.0.0"
}
