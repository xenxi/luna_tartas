{
  "name": "luna-tartas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "lint": "eslint src tests scripts astro.config.mjs",
    "format": "prettier --check \"src/**/*.{astro,ts,js,yml,yaml}\" \"tests/**/*.{ts,js,yml,yaml}\" \"scripts/generate-catalog-schema.ts\" \"schemas/**/*.{json,yml,yaml}\" \"*.{json,mjs}\"",
    "schema:generate": "tsx scripts/generate-catalog-schema.ts",
    "verify:schema": "tsx scripts/generate-catalog-schema.ts --check",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:crawl": "node scripts/verify-crawl.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:structured-data": "node scripts/verify-structured-data.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:determinism": "node scripts/verify-determinism.mjs",
    "verify:mutation": "node scripts/verify-mutation.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:accessibility": "node scripts/verify-accessibility.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:performance": "node scripts/verify-performance.mjs",
    "verify:responsive": "node scripts/verify-responsive.mjs",
    "verify:redirects": "node scripts/verify-redirects.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
