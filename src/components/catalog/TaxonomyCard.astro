---
import ResponsiveMedia from './ResponsiveMedia.astro';
import type { TaxonomyCardProjection } from './types';
import { catalogImageMap } from './catalog-images';
import { buildMediaProjection } from './media-projection';
import { withBasePath } from '../../lib/site/urls';
import './catalog.css';

interface Props {
  taxonomy: TaxonomyCardProjection;
  headingLevel?: 2 | 3;
}

const { taxonomy, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const media =
  taxonomy.media ??
  (taxonomy.mediaSource && catalogImageMap[taxonomy.mediaSource.src]
    ? await buildMediaProjection(
        catalogImageMap[taxonomy.mediaSource.src],
        taxonomy.mediaSource.alt,
      )
    : undefined);

if (!taxonomy.href.startsWith('/') || taxonomy.href.startsWith('//')) {
  throw new Error('TaxonomyCard requires an internal absolute-path href');
}
---

<article class="catalog-card catalog-card--taxonomy">
  <div class="catalog-card__media">
    <ResponsiveMedia media={media} />
  </div>
  <div class="catalog-card__body">
    <Heading class="catalog-card__title">
      <a href={withBasePath(taxonomy.href, import.meta.env.BASE_URL)}
        >{taxonomy.name}</a
      >
    </Heading>
    <p class="catalog-card__summary">{taxonomy.summary}</p>
    {
      taxonomy.itemCountLabel && (
        <p class="catalog-card__meta">{taxonomy.itemCountLabel}</p>
      )
    }
    <span class="catalog-card__action" aria-hidden="true">
      Ver ideas
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M5 12h13M13 7l5 5-5 5"></path>
      </svg>
    </span>
  </div>
</article>
