---
import type { MediaProjection } from './types';
import ResponsiveMedia from './ResponsiveMedia.astro';
import MobileHeroWave from './MobileHeroWave.astro';
import './catalog-hero.css';

interface Props {
  eyebrow: string;
  title: string;
  claim: string;
  description: string;
  media?: MediaProjection;
  headingId?: string;
  variant?: 'split' | 'full-bleed' | 'integrated';
  objectPosition?: string;
  mobileObjectPosition?: string;
}

const {
  eyebrow,
  title,
  claim,
  description,
  media,
  headingId,
  variant = 'split',
  objectPosition = 'center center',
  mobileObjectPosition = '74% center',
} = Astro.props;

const mediaAspect =
  media === undefined ? undefined : media.width / media.height;
const hasExtremeMedia =
  variant === 'integrated' &&
  mediaAspect !== undefined &&
  (mediaAspect < 0.55 || mediaAspect > 2.4);
---

<header
  class:list={[
    'catalog-hero',
    {
      'catalog-hero--without-media': !media,
      'catalog-hero--full-bleed': variant === 'full-bleed',
      'catalog-hero--integrated': variant === 'integrated',
      'catalog-hero--extreme-media': hasExtremeMedia,
    },
  ]}
  style={`--catalog-hero-position: ${objectPosition}; --catalog-hero-mobile-position: ${mobileObjectPosition}`}
>
  <div class="catalog-hero__copy">
    <p class="catalog-hero__eyebrow">
      {eyebrow}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 20S4.5 16 4.5 10.7c0-3.4 4.4-4.6 7.5-.9 3.1-3.7 7.5-2.5 7.5.9C19.5 16 12 20 12 20Z"
        ></path>
      </svg>
    </p>
    <h1 id={headingId}>{title}</h1>
    <p class="catalog-hero__claim">
      {claim}
      <svg viewBox="0 0 44 32" aria-hidden="true" focusable="false">
        <path d="M8 15c0-9 12-11 16-3 4-8 16-6 16 3 0 8-16 16-16 16S8 23 8 15Z"
        ></path>
      </svg>
    </p>
    <p class="catalog-hero__description">{description}</p>
    <slot name="benefits" />
  </div>

  {
    media && (
      <ResponsiveMedia
        media={media}
        loading="eager"
        fetchPriority="high"
        withBackdrop={hasExtremeMedia}
      />
    )
  }

  <svg
    class="catalog-hero__sparkles"
    viewBox="0 0 120 120"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M22 8v28M8 22h28M88 70v38M69 89h38M56 50v16M48 58h16"></path>
  </svg>
  {variant === 'full-bleed' && <MobileHeroWave />}
  <slot name="decoration" />
</header>
