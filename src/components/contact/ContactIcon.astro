---
interface Props {
  name:
    | 'cake'
    | 'stationery'
    | 'print'
    | 'gift'
    | 'instagram'
    | 'email'
    | 'location'
    | 'whatsapp';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['contact-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  focusable="false"
  aria-hidden="true"
>
  {
    name === 'cake' && (
      <>
        <path d="M5 10h14v10H5zM4 8h16v3H4zM12 8v12" />
        <path d="M12 8c-3.4 0-5-1.2-5-2.7C7 4.5 7.7 4 8.5 4 10.5 4 12 8 12 8Zm0 0c3.4 0 5-1.2 5-2.7 0-.8-.7-1.3-1.5-1.3C13.5 4 12 8 12 8Z" />
      </>
    )
  }
  {
    name === 'stationery' && (
      <>
        <path d="M5 3.5h11a2 2 0 0 1 2 2v15H5zM8 3.5v17" />
        <path d="M11 8h4M11 11h4M11 15h3" />
      </>
    )
  }
  {
    name === 'print' && (
      <>
        <rect x="4" y="3" width="16" height="18" rx="1.5" />
        <path d="m7 16 3.3-3.5 2.6 2.5 2.4-2.2L18 16M8 8h.01" />
      </>
    )
  }
  {
    name === 'gift' && (
      <>
        <path d="M4 9h16v11H4zM3 6h18v3H3zM12 6v14" />
        <path d="M12 6C8.8 6 7 4.9 7 3.5 7 2.7 7.7 2.2 8.5 2.2 10.5 2.2 12 6 12 6Zm0 0c3.2 0 5-1.1 5-2.5 0-.8-.7-1.3-1.5-1.3C13.5 2.2 12 6 12 6Z" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="4" />
        <circle class="contact-icon__fill" cx="17.3" cy="6.8" r="0.8" />
      </>
    )
  }
  {
    name === 'email' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === 'location' && (
      <>
        <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
        <circle cx="12" cy="10" r="2.3" />
      </>
    )
  }
  {
    name === 'whatsapp' && (
      <>
        <path d="M20.4 11.7a8.4 8.4 0 0 1-12.5 7.4L3 20.5l1.4-4.7a8.4 8.4 0 1 1 16-4.1Z" />
        <path d="M8.3 7.7c.2-.4.4-.5.7-.5h.4c.2 0 .4.1.5.4l.8 1.9c.1.2.1.4 0 .5l-.5.7c.6 1.2 1.6 2.1 2.8 2.8l.7-.5c.2-.1.4-.1.5 0l1.9.8c.3.1.4.3.4.5v.4c0 .3-.1.5-.5.7-.5.2-1.1.2-1.8 0-1-.3-2.2-1-3.2-2s-1.7-2.2-2-3.2c-.2-.7-.2-1.3 0-1.8Z" />
      </>
    )
  }
</svg>
