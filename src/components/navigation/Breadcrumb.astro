---
import './navigation.css';
import type { BreadcrumbItem } from '../../lib/seo/navigation';
import { withBasePath } from '../../lib/site/urls';

export type BreadcrumbItemProjection = BreadcrumbItem;

interface Props {
  items: readonly BreadcrumbItemProjection[];
  label?: string;
}

const { items, label = 'Migas de pan' } = Astro.props;

if (
  items.length === 0 ||
  items.some((item, index) =>
    index === items.length - 1 ? item.current !== true : item.current === true,
  ) ||
  items.some(
    (item) =>
      !item.current &&
      (!item.href.startsWith('/') || item.href.startsWith('//')),
  )
) {
  throw new Error(
    'Breadcrumb requires linked ancestors and one final current item',
  );
}
---

<nav class="breadcrumb" aria-label={label}>
  <ol>
    {
      items.map((item) => (
        <li>
          {item.current ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={withBasePath(item.href, import.meta.env.BASE_URL)}>
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
