---
import type { Catalog } from '../../lib/catalog/domain/model';
import CardList from '../patterns/CardList.astro';
import ContentSection from '../patterns/ContentSection.astro';
import TaxonomyCard from '../catalog/TaxonomyCard.astro';
import { projectCategoryIndex } from './category-listing';
import './categories.css';

interface Props {
  catalog: Catalog;
}

const { catalog } = Astro.props;
const listing = projectCategoryIndex(catalog);
---

<div class="categories-page">
  <header class="categories-page__header">
    <h1>Categorías de regalos</h1>
    <p>
      Encuentra una idea especial según el tipo de detalle que quieres preparar.
    </p>
  </header>
  <ContentSection
    id="category-list"
    title="Elige por tipo de regalo"
    intro="Descubre ideas agrupadas para encontrar más rápido el detalle que buscas."
  >
    <CardList
      count={listing.items.length}
      emptyMessage="Pronto podrás explorar nuestras categorías de regalos."
    >
      {
        listing.items.map((category) => (
          <li>
            <TaxonomyCard taxonomy={category} />
          </li>
        ))
      }
    </CardList>
  </ContentSection>
</div>
