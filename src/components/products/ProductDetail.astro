---
import type {
  PublishedProduct,
  Taxonomy,
  TaxonomyKind,
} from '../../lib/catalog/domain/model';
import { routes } from '../../lib/catalog/domain/routes';
import type { BreadcrumbItem } from '../../lib/seo/navigation';
import { createProductAnalyticsData } from '../../lib/analytics/product';
import Breadcrumb from '../navigation/Breadcrumb.astro';
import ProductConversionPanel from './ProductConversionPanel.astro';
import ProductGallery from './ProductGallery.astro';
import ProductPersonalization from './ProductPersonalization.astro';
import './product-detail.css';
import { withBasePath } from '../../lib/site/urls';

interface Props {
  product: PublishedProduct;
  taxonomies: Readonly<Record<TaxonomyKind, readonly Taxonomy[]>>;
  breadcrumbs: readonly BreadcrumbItem[];
}

const { product, taxonomies, breadcrumbs } = Astro.props;
const analytics = createProductAnalyticsData(product);

function linkedTaxonomies(kind: TaxonomyKind, ids: readonly string[]) {
  return ids
    .map((id) => taxonomies[kind].find((taxonomy) => taxonomy.id === id))
    .filter((taxonomy): taxonomy is Taxonomy => taxonomy !== undefined);
}

const categories = linkedTaxonomies('category', product.categories);
const occasions = linkedTaxonomies('occasion', product.occasions ?? []);
const recipients = linkedTaxonomies('recipient', product.recipients ?? []);
const taxonomyGroups = [
  { kind: 'category' as const, label: 'Tipo', items: categories },
  { kind: 'occasion' as const, label: 'Ocasión', items: occasions },
  { kind: 'recipient' as const, label: 'Para', items: recipients },
].filter(({ items }) => items.length > 0);
---

<div class="product-detail">
  <Breadcrumb items={breadcrumbs} />

  <article
    class="product-detail__article"
    data-analytics-view-item
    data-analytics-product-id={analytics.productId}
    data-analytics-product-name={analytics.productName}
    data-analytics-category={analytics.category}
  >
    <div class="product-detail__hero">
      <ProductGallery product={product} />

      <div class="product-detail__intro">
        <header class="product-detail__header">
          <p class="product-detail__eyebrow">
            HECHO A MANO, CON AMOR
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M12 20S4.5 16 4.5 10.7c0-3.4 4.4-4.6 7.5-.9 3.1-3.7 7.5-2.5 7.5.9C19.5 16 12 20 12 20Z"
              ></path>
            </svg>
          </p>
          <h1>{product.name}</h1>
          <p class="product-detail__summary">{product.summary}</p>
        </header>

        <ProductConversionPanel product={product} />
        <ProductPersonalization product={product} />
      </div>
    </div>

    <div class="product-detail__body">
      <section
        class="product-detail__story"
        aria-labelledby="product-description-title"
      >
        <p class="product-detail__eyebrow">LA HISTORIA DETRÁS DEL DETALLE</p>
        <h2 id="product-description-title">Sobre esta creación</h2>
        {
          product.description
            .split('\n\n')
            .map((paragraph) => <p>{paragraph}</p>)
        }
      </section>

      {
        taxonomyGroups.length > 0 && (
          <section
            class="product-detail__context"
            aria-labelledby="product-context-title"
          >
            <p class="product-detail__eyebrow">ENCUENTRA MÁS INSPIRACIÓN</p>
            <h2 id="product-context-title">Encuéntralo por intención</h2>
            <div class="product-detail__taxonomy-groups">
              {taxonomyGroups.map(({ kind, label, items }) => (
                <div>
                  <h3>{label}</h3>
                  <ul>
                    {items.map((taxonomy) => (
                      <li>
                        <a
                          href={withBasePath(
                            routes.taxonomy(kind, taxonomy.slug),
                            import.meta.env.BASE_URL,
                          )}
                        >
                          {taxonomy.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</div>
