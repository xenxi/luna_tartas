---
import type { PublishedProduct } from '../../lib/catalog/domain/model';
import { routes } from '../../lib/catalog/domain/routes';
import { whatsappConfig } from '../../config/contact';
import { getCanonicalUrl } from '../../config/site';
import { buildProductWhatsAppUrl } from '../../lib/whatsapp/product';
import { createProductAnalyticsData } from '../../lib/analytics/product';
import { formatPriceLabel } from '../catalog/price';
import ActionLink from '../ui/ActionLink.astro';
import FavoriteButton from '../favorites/FavoriteButton.astro';
import './product-conversion-panel.css';

interface Props {
  product: PublishedProduct;
}

const { product } = Astro.props;
const productUrl = getCanonicalUrl(routes.product(product.slug));
const href = buildProductWhatsAppUrl({
  number: whatsappConfig.number,
  productName: product.name,
  productUrl,
});
const analytics = createProductAnalyticsData(product);
---

<aside class="product-conversion" aria-label="Precio y pedido">
  <div class="product-conversion__summary">
    <p class="product-conversion__price">{formatPriceLabel(product.price)}</p>
    <p class="product-conversion__badge">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 20S4.5 16 4.5 10.7c0-3.4 4.4-4.6 7.5-.9 3.1-3.7 7.5-2.5 7.5.9C19.5 16 12 20 12 20Z"
        ></path>
      </svg>
      Hecho a mano, con amor
    </p>
  </div>

  <div class="product-conversion__action">
    <div class="product-conversion__actions">
      <ActionLink
        href={href}
        ariaLabel={`Pedir ${product.name} por WhatsApp`}
        target="_blank"
        rel="noopener noreferrer"
        analytics={{
          event: 'contact_whatsapp',
          ctaLocation: 'product-detail',
          ...analytics,
        }}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 8h12v11H6zM9 8V6a3 3 0 0 1 6 0v2"></path>
          <path d="M9.5 13.5c1.2 1.5 3.8 1.5 5 0"></path>
        </svg>
        Pedir por WhatsApp
      </ActionLink>
      <FavoriteButton
        productId={product.slug}
        productName={product.name}
        variant="detail"
      />
    </div>
    <p>Te confirmamos disponibilidad y acabamos de definirlo contigo.</p>
  </div>
</aside>
