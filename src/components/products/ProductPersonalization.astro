---
import type { PublishedProduct } from '../../lib/catalog/domain/model';
import { trustAndWorkContent } from '../../content/home/trust-and-work';
import './product-personalization.css';

interface Props {
  product: PublishedProduct;
}

const { product } = Astro.props;
const customization = product.customization;
const hasCustomization = customization.kind === 'available';
---

{
  hasCustomization && (
    <div class="product-personalization">
      <section aria-labelledby="product-customization-title">
        <p class="product-personalization__eyebrow">Personalización</p>
        <h2 id="product-customization-title">La hacemos única para ti</h2>
        <p class="product-personalization__description">
          {customization.description}
        </p>
        <ul class="product-personalization__options">
          {customization.options.map((option) => (
            <li>{option}</li>
          ))}
        </ul>
      </section>

      <aside class="product-personalization__note" aria-label="Pieza única">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 20S4.5 16 4.5 10.7c0-3.4 4.4-4.6 7.5-.9 3.1-3.7 7.5-2.5 7.5.9C19.5 16 12 20 12 20Z" />
        </svg>
        <div>
          <strong>Cada pieza es única</strong>
          <p>
            Puede variar ligeramente al ser un producto artesanal, manteniendo
            siempre el estilo y la calidad.
          </p>
        </div>
      </aside>

      <section class="product-process" aria-labelledby="product-process-title">
        <details>
          <summary id="product-process-title">
            Cómo preparamos tu encargo
          </summary>
          <ol>
            {trustAndWorkContent.trust.steps.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.copy}</p>
              </li>
            ))}
          </ol>
        </details>
      </section>
    </div>
  )
}
