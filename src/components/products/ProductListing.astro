---
import type { Catalog } from '../../lib/catalog/domain/model';
import CardList from '../patterns/CardList.astro';
import ContentSection from '../patterns/ContentSection.astro';
import ProductCard from '../catalog/ProductCard.astro';
import { projectProductListing } from './product-listing';
import { catalogImageMap } from '../catalog/catalog-images';
import { buildSimpleMediaProjection } from '../catalog/media-projection';
import { getPublishedProducts } from '../../lib/catalog/domain/queries';
import type { ProductCardProjection } from '../catalog/types';
import './product-listing.css';

interface Props {
  catalog: Catalog;
}

const { catalog } = Astro.props;
const listing = projectProductListing(catalog);
const domainProducts = getPublishedProducts(catalog);

// Enriquecer cada item con su media resuelta
const itemsWithMedia: ProductCardProjection[] = listing.items.map((item, i) => {
  const domainProduct = domainProducts[i];
  const coverSrc = domainProduct?.media?.cover?.src;
  const coverAlt = domainProduct?.media?.cover?.alt ?? '';
  const imageMetadata = coverSrc ? catalogImageMap[coverSrc] : undefined;
  return {
    ...item,
    media: imageMetadata
      ? buildSimpleMediaProjection(imageMetadata, coverAlt)
      : undefined,
  };
});
---

{
  itemsWithMedia.length > 0 && (
    <div class="product-listing">
      <ContentSection
        id="product-list"
        title={listing.title}
        intro={listing.intro}
      >
        <CardList count={itemsWithMedia.length}>
          {itemsWithMedia.map((product) => (
            <li>
              <ProductCard product={product} />
            </li>
          ))}
        </CardList>
      </ContentSection>
    </div>
  )
}
