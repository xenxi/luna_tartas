---
import type { Catalog } from '../../lib/catalog/domain/model';
import CardList from '../patterns/CardList.astro';
import ContentSection from '../patterns/ContentSection.astro';
import ProductCard from '../catalog/ProductCard.astro';
import {
  indexPublishedProductsByListingHref,
  projectProductListing,
  type ProductListingItemProjection,
} from './product-listing';
import { catalogImageMap } from '../catalog/catalog-images';
import { buildMediaProjection } from '../catalog/media-projection';
import { getPublishedProducts } from '../../lib/catalog/domain/queries';
import './product-listing.css';
import CatalogClouds from '../catalog/CatalogClouds.astro';
import ProductsIdeaCta from './ProductsIdeaCta.astro';
import { productsIndexContent } from '../../content/products-index';
import { routes } from '../../lib/catalog/domain/routes';
import { withBasePath } from '../../lib/site/urls';

interface Props {
  catalog: Catalog;
}

const { catalog } = Astro.props;
const listing = projectProductListing(catalog);
const domainProducts = getPublishedProducts(catalog);
const productsByListingHref =
  indexPublishedProductsByListingHref(domainProducts);

// Enriquecer cada item con su media resuelta
const itemsWithMedia: ProductListingItemProjection[] = await Promise.all(
  listing.items.map(async (item) => {
    const domainProduct = productsByListingHref.get(item.href);
    const coverSrc = domainProduct?.media?.cover?.src;
    const coverAlt = domainProduct?.media?.cover?.alt ?? '';
    const imageMetadata = coverSrc ? catalogImageMap[coverSrc] : undefined;
    return {
      ...item,
      media: imageMetadata
        ? await buildMediaProjection(imageMetadata, coverAlt)
        : undefined,
    };
  }),
);
---

{
  itemsWithMedia.length > 0 && (
    <div class="product-listing" data-product-listing>
      <CatalogClouds />
      <ContentSection
        id="product-list"
        title={listing.title}
        intro={listing.intro}
      >
        <div class="product-listing__tools">
          <form
            class="product-listing__search"
            role="search"
            action={withBasePath(routes.search(), import.meta.env.BASE_URL)}
            data-listing-search
          >
            <label class="visually-hidden" for="listing-search">
              {productsIndexContent.searchLabel}
            </label>
            <button type="submit" aria-label={productsIndexContent.searchLabel}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <>
                  <circle cx="10" cy="10" r="6.5" />
                  <path d="m15 15 5 5" />
                </>
              </svg>
            </button>
            <input
              id="listing-search"
              name="q"
              type="search"
              placeholder={productsIndexContent.searchPlaceholder}
              maxlength="120"
            />
          </form>
          <nav
            class="product-listing__filters"
            aria-label="Filtrar productos por ocasión"
          >
            <a
              href={withBasePath(routes.products(), import.meta.env.BASE_URL)}
              data-listing-filter=""
              aria-current="true"
            >
              {productsIndexContent.allLabel}
            </a>
            {listing.filters.map((filter) => (
              <a
                href={withBasePath(filter.href, import.meta.env.BASE_URL)}
                data-listing-filter={filter.id}
              >
                {filter.label}
              </a>
            ))}
          </nav>
          <div class="product-listing__sort" data-listing-sort-control hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 6h16M4 12h16M4 18h16M8 3v6M16 9v6M10 15v6" />
            </svg>
            <label class="visually-hidden" for="listing-sort">
              {productsIndexContent.sortLabel}
            </label>
            <select id="listing-sort" data-listing-sort>
              {productsIndexContent.sortOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>
        </div>
        <p
          class="visually-hidden"
          role="status"
          aria-live="polite"
          data-listing-status
        />
        <p class="product-listing__empty" data-listing-empty hidden>
          {productsIndexContent.empty}
        </p>
        <CardList count={itemsWithMedia.length + 1} columns={4}>
          {itemsWithMedia.map((product) => (
            <li
              data-listing-item
              data-name={product.name}
              data-search={`${product.name} ${product.summary}`}
              data-occasions={product.occasionIds.join(' ')}
              data-price={product.priceAmountMinor ?? ''}
            >
              <ProductCard product={product} />
            </li>
          ))}
          <li
            class="product-listing__idea"
            style={`--idea-columns: ${4 - (itemsWithMedia.length % 4)}`}
          >
            <ProductsIdeaCta />
          </li>
        </CardList>
      </ContentSection>
    </div>
  )
}

<script>
  import { initProductListing } from './product-listing-client';
  document
    .querySelectorAll<HTMLElement>('[data-product-listing]')
    .forEach(initProductListing);
</script>
