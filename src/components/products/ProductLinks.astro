---
import type { ProductLinks } from '../../lib/catalog/domain/model';
import { projectProductLinks } from './product-links';
interface Props {
  links?: ProductLinks;
}
const links = projectProductLinks(Astro.props.links);
---

{
  links.length > 0 && (
    <nav class="product-links" aria-label="Este producto en otras plataformas">
      <p>También puedes verlo en</p>
      <ul>
        {links.map(({ label, href }) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer">
              {label}
              <span aria-hidden="true">↗</span>
              <span class="visually-hidden"> (abre una nueva pestaña)</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .product-links {
    margin-block: 1.25rem;
  }
  .product-links p {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
  .product-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.65rem 0 0;
    padding: 0;
  }
  .product-links li {
    margin: 0;
  }
  .product-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--font-size-sm);
    background: var(--color-surface);
  }
  .product-links a:hover {
    background: var(--color-surface-warm);
  }
</style>
