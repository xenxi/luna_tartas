---
import { publicContactConfig } from '../../config/contact';
import {
  isCurrentNavigationPath,
  primaryNavigation,
} from '../../config/navigation';
import BrandHomeLink from './BrandHomeLink.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const buildYear = new Date().getUTCFullYear();
const footerNavigation = primaryNavigation.filter(({ href }) => href !== '/');
---

<footer class="site-footer">
  <div class="site-footer__inner visual-container">
    <div class="site-footer__main">
      <div class="site-footer__identity">
        <BrandHomeLink location="footer" />
      </div>

      <div class="site-footer__navigation">
        <nav aria-label="Navegación del pie">
          <ul>
            {
              footerNavigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={
                      isCurrentNavigationPath(currentPath, item.href)
                        ? 'page'
                        : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <address class="site-footer__contact">
        <ul>
          <li>
            <a
              href={publicContactConfig.whatsapp.href}
              aria-label="Escríbenos por WhatsApp"
              data-analytics-custom-whatsapp-click
              data-analytics-cta-location="site-footer"
              data-analytics-source-page={currentPath}
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                focusable="false"
                aria-hidden="true"
              >
                <path
                  d="M19.2 4.8A10 10 0 0 0 3.5 16.9L2.5 21.5l4.8-1A10 10 0 1 0 19.2 4.8Z"
                ></path>
                <path
                  d="M8.2 7.6c.2-.5.4-.5.7-.5h.6c.2 0 .4.1.5.4l.9 2.1c.1.2.1.4 0 .6l-.5.7c.7 1.3 1.7 2.3 3 3l.7-.5c.2-.1.4-.1.6 0l2.1.9c.3.1.4.3.4.5v.6c0 .3-.1.5-.5.7-.5.2-1.2.3-2 .1-1.1-.3-2.4-1.1-3.5-2.2-1.1-1.1-1.9-2.4-2.2-3.5-.2-.8-.1-1.5.1-2Z"
                ></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={publicContactConfig.email.href}
              aria-label="Escríbenos por email"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                focusable="false"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m4 7 8 6 8-6"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={publicContactConfig.instagram.href}
              aria-label="Síguenos en Instagram"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                focusable="false"
                aria-hidden="true"
              >
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle
                  cx="17.3"
                  cy="6.8"
                  r="0.8"
                  fill="currentColor"
                  stroke="none"></circle>
              </svg>
            </a>
          </li>
        </ul>
      </address>
    </div>

    <div class="site-footer__closing">
      <p class="site-footer__signature">
        Hecho con mimo para Luna · Creado por <a href="https://antoniomdm.dev/"
          >Antonio MDM</a
        > · <span class="site-footer__copyright">© {buildYear}</span>
        <span class="site-footer__heart" aria-hidden="true">♥</span>
      </p>
    </div>
  </div>
</footer>
