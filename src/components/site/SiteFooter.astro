---
import { Image } from 'astro:assets';
import footerBrandLogo from '../../assets/brand/logo-luna-detalles-hechos-para-emocionar.png';
import { publicContactConfig } from '../../config/contact';
import {
  isCurrentNavigationPath,
  primaryNavigation,
} from '../../config/navigation';
import { routes } from '../../lib/catalog/domain/routes';
import { withBasePath, withoutBasePath } from '../../lib/site/urls';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const buildYear = new Date().getUTCFullYear();
const footerNavigation = primaryNavigation.filter(({ href }) => href !== '/');
const routePath = withoutBasePath(currentPath, import.meta.env.BASE_URL);
const footerInformation = [
  'Sobre Luna',
  'Cómo trabajamos',
  'Preguntas frecuentes',
  'Contacto',
] as const;
---

<footer
  class:list={[
    'site-footer',
    { 'site-footer--home': routePath === routes.home() },
  ]}
>
  <div class="site-footer__inner visual-container">
    <div class="site-footer__identity">
      <a
        class="brand-home brand-home--footer"
        href={withBasePath(routes.home(), import.meta.env.BASE_URL)}
        aria-label="Luna Tartas"
      >
        <Image
          class="brand-home__logo"
          src={footerBrandLogo}
          alt="Luna, detalles hechos para emocionar"
          width={1774}
          height={887}
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <div class="site-footer__divider" aria-hidden="true"></div>

    <div class="site-footer__navigation">
      <nav aria-label="Navegación del pie">
        <ul>
          {
            footerNavigation.map((item) => (
              <li>
                <a
                  href={withBasePath(item.href, import.meta.env.BASE_URL)}
                  aria-current={
                    isCurrentNavigationPath(routePath, item.href)
                      ? 'page'
                      : undefined
                  }
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="site-footer__information" aria-label="Información de Luna">
        {footerInformation.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="site-footer__contact">
      <address>
        <ul class="site-footer__social">
          <li>
            <a
              href={publicContactConfig.instagram.href}
              aria-label="Síguenos en Instagram"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                focusable="false"
                aria-hidden="true"
              >
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle
                  cx="17.3"
                  cy="6.8"
                  r="0.8"
                  fill="currentColor"
                  stroke="none"></circle>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={publicContactConfig.whatsapp.href}
              aria-label="Escríbenos por WhatsApp"
              data-analytics-contact-whatsapp
              data-analytics-cta-location="site-footer"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                focusable="false"
                aria-hidden="true"
              >
                <path
                  d="M20.4 11.7a8.4 8.4 0 0 1-12.5 7.4L3 20.5l1.4-4.7a8.4 8.4 0 1 1 16-4.1Z"
                ></path>
                <path
                  d="M8.3 7.7c.2-.4.4-.5.7-.5h.4c.2 0 .4.1.5.4l.8 1.9c.1.2.1.4 0 .5l-.5.7c.6 1.2 1.6 2.1 2.8 2.8l.7-.5c.2-.1.4-.1.5 0l1.9.8c.3.1.4.3.4.5v.4c0 .3-.1.5-.5.7-.5.2-1.1.2-1.8 0-1-.3-2.2-1-3.2-2s-1.7-2.2-2-3.2c-.2-.7-.2-1.3 0-1.8Z"
                ></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={publicContactConfig.email.href}
              aria-label="Escríbenos por email"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                focusable="false"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m4 7 8 6 8-6"></path>
              </svg>
            </a>
          </li>
        </ul>
      </address>

      <div class="site-footer__closing">
        <p class="site-footer__signature">
          Hecho con mimo para Luna · Creado por <a
            href="https://antoniomdm.dev/">Antonio MDM</a
          > · <span class="site-footer__copyright">© {buildYear}</span>
          <span class="site-footer__heart" aria-hidden="true">♥</span>
        </p>
      </div>
    </div>
  </div>
</footer>
