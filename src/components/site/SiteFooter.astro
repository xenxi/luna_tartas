---
import { Image } from 'astro:assets';
import footerFlowers from '../../assets/site/footer-magnolia.png';
import { publicContactConfig } from '../../config/contact';
import { isCurrentNavigationPath } from '../../config/navigation';
import { routes } from '../../lib/catalog/domain/routes';
import { withBasePath, withoutBasePath } from '../../lib/site/urls';
import Ornament from '../ui/Ornament.astro';

interface Props {
  currentPath: string;
}

interface FooterLink {
  readonly label: string;
  readonly href: string;
}

const { currentPath } = Astro.props;
const buildYear = new Date().getUTCFullYear();
const routePath = withoutBasePath(currentPath, import.meta.env.BASE_URL);

const footerProducts: readonly FooterLink[] = [
  {
    label: 'Tartas de pañales',
    href: routes.taxonomy('category', 'tartas-de-panales'),
  },
  {
    label: 'Papelería personalizada',
    href: routes.taxonomy('category', 'papeleria-personalizada'),
  },
  {
    label: 'Láminas personalizadas',
    href: routes.taxonomy('category', 'laminas-personalizadas'),
  },
  {
    label: 'Packs personalizados',
    href: routes.taxonomy('category', 'packs-personalizados'),
  },
];

const footerOccasions: readonly FooterLink[] = [
  {
    label: 'Nacimiento',
    href: routes.taxonomy('occasion', 'nacimiento'),
  },
  {
    label: 'Baby shower',
    href: routes.taxonomy('occasion', 'baby-shower'),
  },
  {
    label: 'Cumpleaños',
    href: routes.taxonomy('occasion', 'cumpleanos'),
  },
  {
    label: 'Primera Comunión',
    href: routes.taxonomy('occasion', 'comunion'),
  },
  { label: 'Y más', href: routes.taxonomyIndex('occasion') },
];

const footerInformation = [
  'Sobre Luna',
  'Cómo trabajamos',
  'Envíos y entregas',
  'Preguntas frecuentes',
  'Contacto',
] as const;

const footerHref = (href: string): string =>
  withBasePath(href, import.meta.env.BASE_URL);
const underConstructionHref = footerHref(routes.underConstruction());
---

<footer class="site-footer">
  <div class="site-footer__inner visual-container">
    <div class="site-footer__main">
      <nav class="site-footer__columns" aria-label="Navegación del pie">
        <section class="site-footer__group">
          <h2>Productos</h2>
          <ul>
            {
              footerProducts.map((item) => (
                <li>
                  <a
                    href={footerHref(item.href)}
                    aria-current={
                      isCurrentNavigationPath(routePath, item.href)
                        ? 'page'
                        : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="site-footer__group">
          <h2>Categorías</h2>
          <ul>
            {
              footerOccasions.map((item) => (
                <li>
                  <a
                    href={footerHref(item.href)}
                    aria-current={
                      isCurrentNavigationPath(routePath, item.href)
                        ? 'page'
                        : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="site-footer__group site-footer__group--information">
          <h2>Información</h2>
          <ul>
            {
              footerInformation.map((item) => (
                <li>
                  <a href={underConstructionHref}>{item}</a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="site-footer__group site-footer__group--follow">
          <h2>Síguenos</h2>
          <address aria-label="Canales de contacto">
            <ul class="site-footer__social">
              <li>
                <a
                  href={publicContactConfig.instagram.href}
                  aria-label="Síguenos en Instagram"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    focusable="false"
                    aria-hidden="true"
                  >
                    <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"
                    ></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle
                      cx="17.3"
                      cy="6.8"
                      r="0.8"
                      fill="currentColor"
                      stroke="none"></circle>
                  </svg>
                </a>
              </li>
              <li>
                <a
                  href={publicContactConfig.whatsapp.href}
                  aria-label="Escríbenos por WhatsApp"
                  data-analytics-contact-whatsapp
                  data-analytics-cta-location="site-footer"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    focusable="false"
                    aria-hidden="true"
                  >
                    <path
                      d="M20.4 11.7a8.4 8.4 0 0 1-12.5 7.4L3 20.5l1.4-4.7a8.4 8.4 0 1 1 16-4.1Z"
                    ></path>
                    <path
                      d="M8.3 7.7c.2-.4.4-.5.7-.5h.4c.2 0 .4.1.5.4l.8 1.9c.1.2.1.4 0 .5l-.5.7c.6 1.2 1.6 2.1 2.8 2.8l.7-.5c.2-.1.4-.1.5 0l1.9.8c.3.1.4.3.4.5v.4c0 .3-.1.5-.5.7-.5.2-1.1.2-1.8 0-1-.3-2.2-1-3.2-2s-1.7-2.2-2-3.2c-.2-.7-.2-1.3 0-1.8Z"
                    ></path>
                  </svg>
                </a>
              </li>
              <li>
                <a
                  href={publicContactConfig.email.href}
                  aria-label="Escríbenos por email"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    focusable="false"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="m4 7 8 6 8-6"></path>
                  </svg>
                </a>
              </li>
            </ul>
          </address>
        </section>
      </nav>

      <div class="site-footer__message">
        <p>
          Hecho a mano,<br />
          con amor, para<br />
          momentos únicos.
        </p>
        <Ornament variant="heart" tone="accent" class="site-footer__heart" />
        <Image
          class="site-footer__flowers"
          src={footerFlowers}
          alt="Rama de magnolias rosas pintada a mano."
          width={260}
          height={407}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
  <slot />
  <div class="site-footer__closing visual-container">
    <p class="site-footer__signature">
      Hecho con mimo para Luna · Creado por <a href="https://antoniomdm.dev/"
        >Antonio MDM</a
      > · <span class="site-footer__copyright">© {buildYear}</span>
    </p>
  </div>
</footer>
