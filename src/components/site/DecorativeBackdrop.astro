---
import Ornament from '../ui/Ornament.astro';
import './decorative-backdrop.css';
---

<div class="decorative-backdrop" aria-hidden="true">
  <Ornament
    variant="watercolor"
    tone="blush"
    class="decorative-backdrop__wash decorative-backdrop__wash--top"
  />
  <Ornament
    variant="cloud"
    tone="blue"
    class="decorative-backdrop__cloud decorative-backdrop__cloud--top"
  />
  <Ornament
    variant="watercolor"
    tone="blue"
    class="decorative-backdrop__wash decorative-backdrop__wash--bottom"
  />
  <Ornament
    variant="mini-hearts"
    tone="accent"
    class="decorative-backdrop__hearts"
  />
  <Ornament
    variant="sparkle"
    tone="peach"
    class="decorative-backdrop__sparkle"
  />
</div>
