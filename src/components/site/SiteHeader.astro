---
import Ornament from '../ui/Ornament.astro';
import BrandHomeLink from './BrandHomeLink.astro';
import PrimaryNavigation from './PrimaryNavigation.astro';
import { routes } from '../../lib/catalog/domain/routes';
import { withBasePath } from '../../lib/site/urls';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header
  class:list={['site-header', { 'site-header--home': currentPath === '/' }]}
>
  <div class="site-header__inner visual-container">
    <BrandHomeLink location="header" />
    <div class="site-header__mobile-actions">
      <a
        class="site-header__mobile-action"
        href={withBasePath(
          routes.underConstruction(),
          import.meta.env.BASE_URL,
        )}
        aria-label="Favoritos"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M20.8 8.8c0 5.2-8.8 10.1-8.8 10.1S3.2 14 3.2 8.8A4.3 4.3 0 0 1 11 5.9a4.3 4.3 0 0 1 7.8 2.9Z"
          ></path>
        </svg>
      </a>
      <a
        class="site-header__mobile-action"
        href={withBasePath(
          routes.underConstruction(),
          import.meta.env.BASE_URL,
        )}
        aria-label="Buscar"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="10.8" cy="10.8" r="6.4"></circle>
          <path d="m15.5 15.5 4.1 4.1"></path>
        </svg>
      </a>
    </div>
    <details class="site-menu">
      <summary>Menú</summary>
      <PrimaryNavigation currentPath={currentPath} />
    </details>
    <div class="site-navigation--desktop">
      <PrimaryNavigation currentPath={currentPath} />
    </div>
  </div>
  <div class="site-header__divider" aria-hidden="true">
    <svg
      class="site-header__divider-line"
      viewBox="0 0 1440 28"
      preserveAspectRatio="none"
      focusable="false"
    >
      <path
        class="site-header__divider-fill"
        d="M0 0h1440v16c-175-10-324-15-486-1-90 8-149 4-218-2l-32-1c-27-3-62-1-144 3C356 25 210 5 0 14Z"
      ></path>
      <path d="M0 14C210 5 356 25 560 15C642 11 677 9 704 12"></path>
      <path d="M736 13C805 19 864 23 954 15C1116 1 1265 6 1440 16"></path>
    </svg>
    <Ornament
      variant="heart"
      tone="accent"
      class="site-header__divider-heart"
    />
  </div>
</header>
