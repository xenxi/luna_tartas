---
import { Image } from 'astro:assets';
import brandLogo from '../../assets/brand/logo-luna-tartas.png';
import desktopBrandLogo from '../../assets/brand/logo-luna-detalles-hechos-para-emocionar.png';
import { getPublishableText, siteConfig } from '../../config/site';
import { routes } from '../../lib/catalog/domain/routes';
import { withBasePath } from '../../lib/site/urls';

interface Props {
  location?: 'header' | 'footer';
}

const { location = 'header' } = Astro.props;
const brandName = getPublishableText(siteConfig.brandName);
const accessibleBrandName = brandName ?? 'Luna Tartas';
---

<a
  class:list={['brand-home', `brand-home--${location}`]}
  href={withBasePath(routes.home(), import.meta.env.BASE_URL)}
  aria-label={accessibleBrandName}
>
  <picture class="brand-home__picture" data-performance-audit="art-directed">
    <source media="(max-width: 47.99rem)" srcset={desktopBrandLogo.src} />
    <source media="(min-width: 48rem)" srcset={desktopBrandLogo.src} />
    <Image
      class="brand-home__logo"
      src={brandLogo}
      alt={accessibleBrandName}
      width={230}
      height={153}
      densities={[1, 2]}
      loading="eager"
      decoding="async"
    />
  </picture>
</a>
