---
import { Image } from 'astro:assets';
import brandLogo from '../../assets/brand/logo-luna-tartas.png';
import { getPublishableText, siteConfig } from '../../config/site';
import { routes } from '../../lib/catalog/domain/routes';

interface Props {
  location?: 'header' | 'footer';
}

const { location = 'header' } = Astro.props;
const brandName = getPublishableText(siteConfig.brandName);
const accessibleBrandName = brandName ?? 'Luna Tartas';
---

<a
  class:list={['brand-home', `brand-home--${location}`]}
  href={routes.home()}
  aria-label={accessibleBrandName}
>
  <Image
    class="brand-home__logo"
    src={brandLogo}
    alt={accessibleBrandName}
    width={230}
    height={153}
    densities={[1, 2]}
    loading="eager"
    decoding="async"
  />
</a>
