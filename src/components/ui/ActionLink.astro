---
import './ui.css';
import { withBasePath } from '../../lib/site/urls';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  ariaLabel?: string;
  target?: '_blank';
  rel?: string;
  analytics?: {
    event: 'contact_whatsapp';
    ctaLocation: string;
    sourcePage?: string;
    productId?: string;
    productName?: string;
    category?: string;
  };
}

const {
  href,
  variant = 'primary',
  ariaLabel,
  target,
  rel,
  analytics,
} = Astro.props;

if (!href || href.startsWith('javascript:')) {
  throw new Error('ActionLink requires a safe href');
}
---

<a
  class:list={['action-link', `action-link--${variant}`]}
  href={withBasePath(href, import.meta.env.BASE_URL)}
  aria-label={ariaLabel}
  target={target}
  rel={rel}
  data-analytics-contact-whatsapp={analytics?.event === 'contact_whatsapp'
    ? ''
    : undefined}
  data-analytics-cta-location={analytics?.ctaLocation}
  data-analytics-product-id={analytics?.productId}
  data-analytics-product-name={analytics?.productName}
  data-analytics-category={analytics?.category}
>
  <slot />
</a>
