---
import { Image, Picture } from 'astro:assets';
import blushBackground from '../../assets/home/custom-idea/fondo.png';
import centralImage from '../../assets/home/custom-idea/imagen-central.png';
import blueCloud from '../../assets/home/custom-idea/nube-azul.png';
import pinkCloud from '../../assets/home/custom-idea/nube-rosa.png';
import lunaCloud from '../../assets/home/luna-nube.png';
import { customIdeaContent } from '../../content/home/custom-idea';
import ActionLink from '../ui/ActionLink.astro';
import Ornament from '../ui/Ornament.astro';
import './custom-idea.css';
---

<section
  class="custom-idea"
  id="custom-idea"
  aria-labelledby="custom-idea-title"
>
  <div class="custom-idea__panel">
    <Picture
      src={blushBackground}
      alt="Acuarela rosa con pequeños corazones decorativos."
      aria-hidden="true"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[960, 1440, 2172]}
      sizes="(min-width: 64rem) 92vw, 100vw"
      loading="lazy"
      decoding="async"
      class="custom-idea__background"
      pictureAttributes={{ class: 'custom-idea__background-picture' }}
    />
    <Image
      src={blueCloud}
      alt="Nube azul de acuarela decorativa."
      aria-hidden="true"
      width={384}
      height={202}
      format="webp"
      loading="lazy"
      decoding="async"
      class="custom-idea__cloud custom-idea__cloud--blue"
    />
    <Image
      src={pinkCloud}
      alt="Nube rosa de acuarela decorativa."
      aria-hidden="true"
      width={384}
      height={256}
      format="webp"
      loading="lazy"
      decoding="async"
      class="custom-idea__cloud custom-idea__cloud--pink"
    />

    <div class="custom-idea__copy">
      <h2 id="custom-idea-title">{customIdeaContent.title}</h2>
      <p>{customIdeaContent.copy}</p>
      <div class="custom-idea__action">
        <ActionLink
          href={customIdeaContent.action.href}
          variant="secondary"
          analytics={{
            event: 'contact_whatsapp',
            ctaLocation: 'home-custom-idea',
            sourcePage: '/',
          }}
        >
          {customIdeaContent.action.label}
          <svg
            class="custom-idea__whatsapp-icon"
            viewBox="0 0 24 24"
            fill="none"
            focusable="false"
            aria-hidden="true"
          >
            <path
              d="M19.2 4.8A10 10 0 0 0 3.5 16.9L2.5 21.5l4.8-1A10 10 0 1 0 19.2 4.8Z"
            ></path>
            <path
              d="M8.2 7.6c.2-.5.4-.5.7-.5h.6c.2 0 .4.1.5.4l.9 2.1c.1.2.1.4 0 .6l-.5.7c.7 1.3 1.7 2.3 3 3l.7-.5c.2-.1.4-.1.6 0l2.1.9c.3.1.4.3.4.5v.6c0 .3-.1.5-.5.7-.5.2-1.2.3-2 .1-1.1-.3-2.4-1.1-3.5-2.2-1.1-1.1-1.9-2.4-2.2-3.5-.2-.8-.1-1.5.1-2Z"
            ></path>
          </svg>
        </ActionLink>
      </div>
    </div>

    <Picture
      src={centralImage}
      alt={customIdeaContent.media.image.alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[320, 480, 640, 768, 960, 1200]}
      sizes="(min-width: 64rem) min(48vw, 42rem), (min-width: 40rem) 70vw, calc(100vw - 2rem)"
      loading="lazy"
      decoding="async"
      class="custom-idea__art"
      pictureAttributes={{ class: 'custom-idea__art-picture' }}
    />
    <Image
      src={lunaCloud}
      alt="Luna sobre una nube decorativa."
      aria-hidden="true"
      width={150}
      height={150}
      format="webp"
      loading="lazy"
      decoding="async"
      class="custom-idea__moon"
    />
    <Ornament variant="heart" tone="accent" class="custom-idea__heart" />
    <Ornament variant="sparkle" tone="peach" class="custom-idea__sparkle" />
  </div>
</section>
