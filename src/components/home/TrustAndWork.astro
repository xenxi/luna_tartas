---
import { Picture } from 'astro:assets';
import blueCake from '../../assets/home/work-showcase/tarta-azul-completa.png';
import pinkCake from '../../assets/home/work-showcase/tarta-rosa-completa.png';
import pinkCakeDetail from '../../assets/home/work-showcase/tarta-rosa-detalle.png';
import stitchCake from '../../assets/home/work-showcase/tarta-stitch-completa.png';
import { trustAndWorkContent } from '../../content/home/trust-and-work';
import ContentSection from '../patterns/ContentSection.astro';
import './trust-and-work.css';

const imageAssets = {
  'tarta-rosa-completa': pinkCake,
  'tarta-stitch-completa': stitchCake,
  'tarta-azul-completa': blueCake,
  'tarta-rosa-detalle': pinkCakeDetail,
} as const;
---

<div class="trust-and-work">
  <ContentSection id="trust" title={trustAndWorkContent.trust.title}>
    <ol class="trust-list">
      {
        trustAndWorkContent.trust.steps.map((step) => (
          <li class="trust-card">
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </li>
        ))
      }
    </ol>
  </ContentSection>

  <ContentSection id="work-showcase" title={trustAndWorkContent.showcase.title}>
    <ul class="work-gallery" aria-label="Selección de trabajos realizados">
      {
        trustAndWorkContent.showcase.images.map((image) => (
          <li
            class:list={[
              'work-gallery__item',
              { 'work-gallery__item--primary': image.primary },
            ]}
          >
            <figure class="work-gallery__figure">
              <Picture
                src={imageAssets[image.id]}
                alt={image.alt}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                quality={50}
                widths={
                  image.primary ? [320, 480, 768, 1024, 1536] : [320, 480, 640]
                }
                sizes={
                  image.primary
                    ? '(min-width: 72rem) 52rem, 100vw'
                    : '(min-width: 72rem) 22rem, (min-width: 40rem) 30vw, 100vw'
                }
                loading="lazy"
                decoding="async"
                class="work-gallery__image"
                pictureAttributes={{ class: 'work-gallery__picture' }}
              />
            </figure>
          </li>
        ))
      }
    </ul>
  </ContentSection>
</div>
