---
import chatStep from '../../assets/home/trust-steps/01-chat.png';
import handsStep from '../../assets/home/trust-steps/02-manos.png';
import heartStep from '../../assets/home/trust-steps/03-corazon.png';
import { Image } from 'astro:assets';
import heartWatercolor from '../../assets/home/heart-watercolor.png';
import { trustAndWorkContent } from '../../content/home/trust-and-work';
import './trust-and-work.css';
import Ornament from '../ui/Ornament.astro';
const trustStepImages = [chatStep, undefined, handsStep, heartStep];
---

<section class="trust-and-work" aria-labelledby="trust-title">
  <div class="trust-process" id="trust">
    <header class="trust-process__header">
      <h2 id="trust-title">
        {trustAndWorkContent.trust.title}<Image
          src={heartWatercolor}
          width={40}
          format="webp"
          alt="Corazón decorativo en acuarela."
          aria-hidden="true"
          class="trust-process__title-heart"
          loading="lazy"
        />
        <Ornament variant="heart" class="trust-process__title-outline" />
      </h2>
      <p>{trustAndWorkContent.trust.intro}</p>
    </header>
    <div class="trust-story">
      <Ornament variant="heart" class="trust-story__heart" />
      <Ornament
        variant="sparkle"
        tone="peach"
        class="trust-story__sparkle trust-story__sparkle--first"
      />
      <Ornament
        variant="sparkle"
        tone="peach"
        class="trust-story__sparkle trust-story__sparkle--middle"
      />
      <Ornament
        variant="sparkle"
        tone="peach"
        class="trust-story__sparkle trust-story__sparkle--last"
      />
      <svg
        class="trust-story__thread"
        viewBox="0 0 1200 100"
        preserveAspectRatio="none"
        aria-hidden="true"
        ><path
          d="M0 50Q75 10 150 50T300 50T450 50T600 50T750 50T900 50T1050 50T1200 50"
        ></path></svg
      >
      <ol class="trust-list">
        {
          trustAndWorkContent.trust.steps.map((step, index) => (
            <li class="trust-card">
              {index < trustAndWorkContent.trust.steps.length - 1 && (
                <svg
                  class="trust-card__connector"
                  viewBox="0 0 240 64"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M0 32C45 74 69 52 119 28S200 14 240 32" />
                </svg>
              )}
              <span class="trust-card__art" aria-hidden="true">
                {trustStepImages[index] ? (
                  <Image
                    src={trustStepImages[index]!}
                    width={128}
                    format="webp"
                    alt="Ilustración decorativa del paso."
                    loading="lazy"
                  />
                ) : (
                  <svg class="trust-card__idea" viewBox="0 0 64 64">
                    <circle cx="32" cy="32" r="30" />
                    <path d="M24 37c-9-10-2-22 8-22s17 12 8 22c-3 3-3 5-3 8H27c0-3 0-5-3-8Z" />
                    <path d="M27 49h10m-8 4h6M32 5v5M11 16l5 4M53 16l-5 4M9 34h6m34 0h6M29 26l3 5 3-5m-3 5v14" />
                  </svg>
                )}
              </span>
              <div class="trust-card__body">
                <span class="trust-card__number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <>
                  <h3>{step.title}</h3>
                  <p>{step.copy}</p>
                </>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
