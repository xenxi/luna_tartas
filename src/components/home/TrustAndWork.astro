---
import chatStep from '../../assets/home/trust-steps/01-chat.png';
import handsStep from '../../assets/home/trust-steps/02-manos.png';
import heartStep from '../../assets/home/trust-steps/03-corazon.png';
import heartWatercolor from '../../assets/home/heart-watercolor.png';
import { trustAndWorkContent } from '../../content/home/trust-and-work';
import Ornament from '../ui/Ornament.astro';
import './trust-and-work.css';

const trustStepImages = [chatStep, handsStep, heartStep] as const;
---

<div class="trust-and-work">
  <section class="trust-process" id="trust" aria-labelledby="trust-title">
    <header class="trust-process__header">
      <h2 id="trust-title">
        {trustAndWorkContent.trust.title}
        <img
          class="trust-process__title-heart"
          src={heartWatercolor.src}
          width={heartWatercolor.width}
          height={heartWatercolor.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </h2>
      <p>{trustAndWorkContent.trust.intro}</p>
    </header>
    <div class="trust-story">
      <ol class="trust-list">
        {
          trustAndWorkContent.trust.steps.map((step, index) => (
            <li class="trust-card">
              {index === 0 && (
                <svg
                  class="trust-story__thread"
                  viewBox="0 0 1200 180"
                  preserveAspectRatio="none"
                  focusable="false"
                  aria-hidden="true"
                >
                  <defs>
                    <linearGradient
                      id="trust-thread-gradient"
                      x1="0"
                      x2="1"
                      y1="0"
                      y2="0"
                    >
                      <stop
                        offset="0"
                        stop-color="var(--color-decoration-accent)"
                      />
                      <stop
                        offset="0.28"
                        stop-color="var(--color-decoration-blush)"
                      />
                      <stop
                        offset="0.52"
                        stop-color="var(--color-decoration-blue)"
                      />
                      <stop
                        offset="0.72"
                        stop-color="var(--color-surface-calm)"
                      />
                      <stop
                        offset="1"
                        stop-color="var(--color-decoration-peach)"
                      />
                    </linearGradient>
                  </defs>
                  <path d="M276 93c61-34 139-34 205-4 20 9 35 12 52 9" />
                  <path d="M668 91c50-28 105-35 157-12 35 16 65 14 105-6" />
                </svg>
              )}
              <span class="trust-card__art" aria-hidden="true">
                <img
                  src={trustStepImages[index].src}
                  width={trustStepImages[index].width}
                  height={trustStepImages[index].height}
                  alt="Ilustración decorativa del paso"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="trust-card__body">
                <span
                  class="trust-card__number"
                  class:list={[`trust-card__number--${index + 1}`]}
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3>{step.title}</h3>
                <p>{step.copy}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <Ornament variant="heart" tone="blush" class="trust-story__left-heart" />
      <Ornament
        variant="sparkle"
        tone="blue"
        class="trust-story__left-sparkle"
      />
      <Ornament
        variant="heart"
        tone="blush"
        class="trust-story__left-lower-heart"
      />
      <Ornament variant="heart" tone="blush" class="trust-story__line-heart" />
      <Ornament variant="sparkle" tone="peach" class="trust-story__sparkle" />
      <Ornament
        variant="sparkle"
        tone="peach"
        class="trust-story__right-sparkle"
      />
      <Ornament variant="heart" tone="blush" class="trust-story__heart" />
      <Ornament
        variant="heart"
        tone="accent"
        class="trust-story__right-heart"
      />
      <Ornament
        variant="heart"
        tone="blue"
        class="trust-story__right-blue-heart"
      />
    </div>
  </section>
</div>
