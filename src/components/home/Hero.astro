---
import { Image, Picture } from 'astro:assets';
import watercolorCloud from '../../assets/home/hero-watercolor-cloud.png';
import heroImage from '../../assets/home/tarta-hero.png';
import { heroContent } from '../../content/home/hero';
import ActionLink from '../ui/ActionLink.astro';
import Icon from '../ui/Icon.astro';
import Ornament from '../ui/Ornament.astro';
import './hero.css';

const [headingLead, headingEmphasis] = heroContent.heading.split(
  /(?<=\.)\s+/,
  2,
);
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__frame">
    <div class="hero__title">
      <h1 id="hero-heading">
        <span class="hero__heading-lead">{headingLead}</span>
        <span class="hero__heading-emphasis">
          {headingEmphasis}
          <Ornament
            variant="underline"
            motion="draw"
            class="hero__heading-underline"
          />
        </span>
      </h1>
    </div>

    <div class="hero__media">
      <Picture
        src={heroImage}
        alt={heroContent.image.alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[320, 480, 640, 768, 960, 1200, 1672]}
        sizes="(min-width: 60rem) 50vw, (min-width: 40rem) 92vw, calc(100vw - 2rem)"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="hero__image"
        pictureAttributes={{ class: 'hero__picture' }}
      />
    </div>

    <Ornament
      variant="mini-hearts"
      tone="accent"
      class="hero__decoration hero__decoration--hearts"
    />
    <Ornament
      variant="sparkle"
      tone="peach"
      class="hero__decoration hero__decoration--sparkle"
    />
    <Ornament
      variant="heart"
      tone="blue"
      class="hero__decoration hero__decoration--heart"
    />

    <div class="hero__body">
      <p>{heroContent.copy.join(' ')}</p>
      <div class="hero__actions">
        <ActionLink href={heroContent.primaryAction.href}>
          {heroContent.primaryAction.label}
          <Icon name="arrow-right" />
        </ActionLink>
        <ActionLink
          href={heroContent.secondaryAction.href}
          variant="secondary"
          analytics={{
            event: 'custom_whatsapp_click',
            ctaLocation: 'home-hero',
            sourcePage: '/',
          }}
        >
          {heroContent.secondaryAction.label}
        </ActionLink>
      </div>
    </div>
  </div>
  <div class="hero__transition" aria-hidden="true">
    <svg
      class="hero__transition-cutout"
      viewBox="0 0 1440 96"
      preserveAspectRatio="none"
      focusable="false"
    >
      <path
        d="M0 31C192 1 306 52 512 28c91-11 154-29 221-14l32 3c119 31 226-8 343 5 117 12 213 37 332 11v63H0Z"
      ></path>
    </svg>
    <Image
      src={watercolorCloud}
      alt="Nube azul de acuarela decorativa."
      width={512}
      height={256}
      densities={[1, 2]}
      format="webp"
      loading="lazy"
      decoding="async"
      class="hero__transition-cloud"
    />
    <svg
      class="hero__transition-line"
      viewBox="0 0 1440 56"
      preserveAspectRatio="none"
      focusable="false"
    >
      <path d="M0 31C192 1 306 52 512 28c91-11 154-29 221-14"></path>
      <path d="M765 17c119 31 226-8 343 5 117 12 213 37 332 11"></path>
    </svg>
    <Ornament variant="heart" tone="accent" class="hero__transition-heart" />
  </div>
</section>
