---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/home/tarta-hero.png';
import { heroContent } from '../../content/home/hero';
import ActionLink from '../ui/ActionLink.astro';
import Ornament from '../ui/Ornament.astro';
import './hero.css';

const [headingLead, headingEmphasis] = heroContent.heading.split(
  /(?<=\.)\s+/,
  2,
);
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__frame visual-container">
    <div class="hero__title">
      <h1 id="hero-heading">
        <span>{headingLead}</span>
        <span class="hero__heading-emphasis">
          {headingEmphasis}
          <Ornament
            variant="underline"
            motion="draw"
            class="hero__heading-underline"
          />
        </span>
      </h1>
    </div>

    <div class="hero__media">
      <Picture
        src={heroImage}
        alt={heroContent.image.alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[320, 480, 640, 768, 960, 1200, 1672]}
        sizes="(min-width: 90rem) 43rem, (min-width: 60rem) 53vw, (min-width: 40rem) 92vw, calc(100vw - 2rem)"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="hero__image"
        pictureAttributes={{ class: 'hero__picture' }}
      />
    </div>

    <div class="hero__body">
      <p>{heroContent.copy.join(' ')}</p>
      <div class="hero__actions">
        <ActionLink href={heroContent.primaryAction.href}>
          {heroContent.primaryAction.label}
        </ActionLink>
        <ActionLink href={heroContent.secondaryAction.href} variant="secondary">
          {heroContent.secondaryAction.label}
        </ActionLink>
      </div>
    </div>
  </div>
  <Ornament variant="thread" motion="draw" class="hero__transition" />
</section>
