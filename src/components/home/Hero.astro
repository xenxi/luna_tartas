---
import { Image, Picture } from 'astro:assets';
import heroImage from '../../assets/home/tarta-hero.png';
import heartWatercolor from '../../assets/home/heart-watercolor.png';
import { heroContent } from '../../content/home/hero';
import ActionLink from '../ui/ActionLink.astro';
import Icon from '../ui/Icon.astro';
import Ornament from '../ui/Ornament.astro';
import './hero.css';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__frame">
    <div class="hero__title">
      <p class="hero__eyebrow">
        <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path
            d="M9 14.8S3.1 11.5 3.1 7.2c0-2.7 3.4-3.7 5.9-.9 2.5-2.8 5.9-1.8 5.9.9 0 4.3-5.9 7.6-5.9 7.6Z"
          ></path>
        </svg>
        <span>{heroContent.eyebrow}</span>
        <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path
            d="M9 14.8S3.1 11.5 3.1 7.2c0-2.7 3.4-3.7 5.9-.9 2.5-2.8 5.9-1.8 5.9.9 0 4.3-5.9 7.6-5.9 7.6Z"
          ></path>
        </svg>
      </p>
      <h1 id="hero-heading">
        <span>{heroContent.heading[0]}</span>
        <span>{heroContent.heading[1]}</span>
      </h1>
      <div class="hero__claim">
        <span>{heroContent.claim}</span>
        <svg
          class="hero__claim-stroke"
          viewBox="0 0 380 32"
          preserveAspectRatio="xMinYMid meet"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M2 17c35-9 68 8 104 0s69 8 105 0 70 8 105 0c13-3 23-2 33 0"
          ></path>
          <path
            d="M345 15c0-8 11-10 15-3 4-7 15-5 15 3 0 7-15 15-15 15s-15-8-15-15Z"
            transform="translate(5 0) translate(0 16) scale(1 1.12) translate(0 -16)"
          ></path>
        </svg>
      </div>
    </div>

    <div class="hero__media">
      <Picture
        src={heroImage}
        alt={heroContent.image.alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[320, 480, 640, 768, 960, 1200, 1672]}
        sizes="(min-width: 60rem) 58vw, (min-width: 40rem) 92vw, calc(100vw - 2rem)"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="hero__image"
        pictureAttributes={{ class: 'hero__picture' }}
      />
    </div>

    <div class="hero__seal" aria-hidden="true">
      <Image
        class="hero__seal-heart"
        src={heartWatercolor}
        width={heartWatercolor.width}
        height={heartWatercolor.height}
        format="webp"
        alt="Corazón decorativo en acuarela."
        loading="lazy"
        decoding="async"
      />
      <span>Hecho<br />con amor</span>
      <svg viewBox="0 0 24 20" focusable="false">
        <path
          d="M12 17S4.8 13.2 4.8 8c0-3.2 4.2-4.4 7.2-.9 3-3.5 7.2-2.3 7.2.9 0 5.2-7.2 9-7.2 9Z"
        ></path>
      </svg>
    </div>

    <div class="hero__body">
      <p>{heroContent.copy.join(' ')}</p>
      <div class="hero__actions">
        <ActionLink href={heroContent.primaryAction.href}>
          {heroContent.primaryAction.label}
          <Icon name="arrow-right" />
        </ActionLink>
        <ActionLink
          href={heroContent.secondaryAction.href}
          variant="secondary"
          analytics={{
            event: 'contact_whatsapp',
            ctaLocation: 'home-hero',
            sourcePage: '/',
          }}
        >
          {heroContent.secondaryAction.label}
          <svg
            class="hero__whatsapp"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26C2.16 6.44 6.6 2 12.05 2c2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.9 6.99c0 5.45-4.44 9.88-9.89 9.88M20.46 3.49A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.23-6.16-3.48-8.41Z"
            ></path>
          </svg>
        </ActionLink>
      </div>
    </div>

    <ul class="hero__benefits" aria-label="Beneficios de Luna Tartas">
      {
        heroContent.benefits.map((benefit) => (
          <li>
            <span class="hero__benefit-icon" aria-hidden="true">
              {benefit.icon === 'heart' && (
                <svg viewBox="0 0 32 32" focusable="false">
                  <path d="M16 27S5 21.2 5 13.3C5 8.4 11.4 6.6 16 12c4.6-5.4 11-3.6 11 1.3C27 21.2 16 27 16 27Z" />
                  <path d="M10 5.5v3M8.5 7h3" />
                </svg>
              )}
              {benefit.icon === 'hands' && (
                <svg viewBox="0 0 32 32" focusable="false">
                  <path d="m6 18 5.4 7.2c1.2 1.6 3.1 2.5 5.1 2.5h1.8c2.2 0 4.2-1.1 5.4-2.9L27 20c.6-.9.4-2.1-.4-2.7-.8-.6-2-.5-2.7.2l-2.6 2.9" />
                  <path d="m14.6 19.8-5-6.5c-.7-.9-2-1.1-2.9-.4-.9.7-1.1 2-.4 2.9l4.7 6.1M18.3 19l-4.9-8.4c-.6-1-1.8-1.3-2.8-.8-1 .6-1.3 1.8-.7 2.8l4.7 8M21.3 20.4l-3.6-8.8c-.4-1-1.6-1.5-2.6-1.1-1 .4-1.5 1.6-1.1 2.6l2.7 6.6" />
                </svg>
              )}
              {benefit.icon === 'quality' && (
                <svg viewBox="0 0 32 32" focusable="false">
                  <path d="m16 4 3.2 3.3 4.5-.1-.1 4.5 3.3 3.2-3.3 3.2.1 4.5-4.5-.1L16 26l-3.2-3.5-4.5.1.1-4.5L5 14.9l3.4-3.2-.1-4.5 4.5.1L16 4Z" />
                  <path d="m11.8 15 2.7 2.8 5.8-6" />
                </svg>
              )}
              {benefit.icon === 'delivery' && (
                <svg viewBox="0 0 32 32" focusable="false">
                  <path d="M4 9h15v14H4zM19 14h5l4 4v5h-9z" />
                  <circle cx="10" cy="25" r="2.5" />
                  <circle cx="24" cy="25" r="2.5" />
                  <path d="M8 5.5h7M6 13H2" />
                </svg>
              )}
            </span>
            <span>{benefit.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="hero__transition" aria-hidden="true">
    <svg
      class="hero__transition-cutout"
      viewBox="0 0 1440 100"
      preserveAspectRatio="none"
      focusable="false"
    >
      <path
        d="M0 36c150-34 290 20 446 13 117-5 192-29 285-25 106 5 177 30 297 26 153-5 260-32 412-9v59H0Z"
      ></path>
    </svg>
    <svg
      class="hero__transition-line"
      viewBox="0 0 1440 68"
      preserveAspectRatio="none"
      focusable="false"
    >
      <path d="M0 36c150-34 290 20 446 13 117-5 192-29 267-25"></path>
      <path d="M747 26c91 8 163 28 281 24 153-5 260-32 412-9"></path>
    </svg>
    <Ornament variant="heart" tone="accent" class="hero__transition-heart" />
  </div>
</section>
