---
import CardList from '../patterns/CardList.astro';
import ContentSection from '../patterns/ContentSection.astro';
import ProductCard from '../catalog/ProductCard.astro';
import type { Catalog } from '../../lib/catalog/domain/model';
import { projectFeaturedProducts } from './featured-products';
import { catalogImageMap } from '../catalog/catalog-images';
import { buildMediaProjection } from '../catalog/media-projection';
import { getFeaturedProducts } from '../../lib/catalog/domain/queries';
import type { ProductCardProjection } from '../catalog/types';
import './featured-products.css';

interface Props {
  catalog: Catalog;
}

const { catalog } = Astro.props;
const featured = projectFeaturedProducts(catalog);

// Enriquecer cada item con su media resuelta
const featuredWithMedia: ProductCardProjection[] = await Promise.all(
  featured.items.map(async (item, index) => {
    const domainProduct = getFeaturedProducts(catalog)[index];
    const coverSrc = domainProduct?.media?.cover?.src;
    const coverAlt = domainProduct?.media?.cover?.alt ?? '';
    const imageMetadata = coverSrc ? catalogImageMap[coverSrc] : undefined;
    return {
      ...item,
      media: imageMetadata
        ? await buildMediaProjection(imageMetadata, coverAlt)
        : undefined,
    };
  }),
);
---

{
  featuredWithMedia.length > 0 && (
    <div class="featured-products">
      <ContentSection
        id="featured-products"
        title={featured.title}
        intro={featured.intro}
      >
        <CardList count={featuredWithMedia.length}>
          {featuredWithMedia.map((product) => (
            <li>
              <ProductCard product={product} />
            </li>
          ))}
        </CardList>
      </ContentSection>
    </div>
  )
}
