---
import { Image, Picture } from 'astro:assets';
import featuredBackground from '../../assets/home/featured-products/fondo-banner.png';
import lunaBanner from '../../assets/home/featured-products/luna-banner.png';
import heartWatercolor from '../../assets/home/heart-watercolor.png';
import type { Catalog } from '../../lib/catalog/domain/model';
import { catalogImageMap } from '../catalog/catalog-images';
import { buildMediaProjection } from '../catalog/media-projection';
import ResponsiveMedia from '../catalog/ResponsiveMedia.astro';
import Ornament from '../ui/Ornament.astro';
import { projectFeaturedProducts } from './featured-products';
import './featured-products.css';
import { withBasePath } from '../../lib/site/urls';

interface Props {
  catalog: Catalog;
}

const { catalog } = Astro.props;
const featured = projectFeaturedProducts(catalog);
const mosaicItems = featured
  ? await Promise.all(
      featured.items.map(async (item) => {
        const imageMetadata = catalogImageMap[item.mediaSource.src];
        return {
          ...item,
          media: imageMetadata
            ? await buildMediaProjection(imageMetadata, item.mediaSource.alt, {
                sizes:
                  '(min-width: 64rem) 22vw, (min-width: 48rem) 31vw, calc(50vw - 1.5rem)',
                widths: [320, 480, 640, 800],
              })
            : undefined,
        };
      }),
    )
  : [];
---

{
  featured && mosaicItems.length === 5 && (
    <section
      class="featured-products"
      id="featured-products"
      aria-labelledby="featured-products-title"
    >
      <Picture
        src={featuredBackground}
        alt="Fondo de acuarela rosa suave."
        aria-hidden="true"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[768, 1280, 1600]}
        sizes="(min-width: 64rem) 80rem, calc(100vw - 2rem)"
        loading="lazy"
        decoding="async"
        class="featured-products__background"
        pictureAttributes={{ class: 'featured-products__background-picture' }}
      />
      <svg
        class="featured-products__leaves"
        viewBox="0 0 80 160"
        aria-hidden="true"
        focusable="false"
      >
        <g
          fill="#a6b5a1"
          fill-opacity=".72"
          stroke="#83917e"
          stroke-width="1.2"
          stroke-linejoin="round"
        >
          <path d="M28 150C6 142 1 129 0 110c24 7 34 19 28 40Z" />
          <path d="M29 129C42 106 63 100 76 101c-10 26-27 37-47 28Z" />
          <path d="M25 104C3 91 0 75 2 52c20 14 29 31 23 52Z" />
          <path d="M27 96C38 65 57 55 72 54c-6 27-24 44-45 42Z" />
          <path d="M25 68C7 56 3 35 7 17c20 16 23 33 18 51Z" />
          <path d="M32 60C25 34 41 15 59 3c-1 25-9 46-27 57Z" />
        </g>
        <g
          fill="none"
          stroke="#7f8e7b"
          stroke-width="1.3"
          stroke-linecap="round"
        >
          <path d="M33 160C22 119 19 88 34 52L57 7M27 144 4 115M25 128 68 106M23 101 5 60M27 94 65 60M27 71 9 24" />
        </g>
      </svg>
      <Ornament variant="heart" class="featured-products__background-heart" />
      <Ornament
        variant="sparkle"
        tone="peach"
        class="featured-products__background-star"
      />
      <div class="featured-products__editorial">
        <div class="featured-products__luna" aria-hidden="true">
          <Image
            src={lunaBanner}
            alt="Luna de acuarela descansando sobre nubes rosas."
            width={320}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
        <Ornament
          variant="sparkle"
          tone="blue"
          class="featured-products__moon-star featured-products__moon-star--blue"
        />
        <Ornament
          variant="sparkle"
          tone="peach"
          class="featured-products__moon-star featured-products__moon-star--peach"
        />
        <Ornament
          variant="sparkle"
          tone="accent"
          class="featured-products__moon-star featured-products__moon-star--coral"
        />
        <Ornament
          variant="sparkle"
          tone="blush"
          class="featured-products__moon-star featured-products__moon-star--blush"
        />
        <Ornament
          variant="sparkle"
          tone="blue"
          class="featured-products__sparkle featured-products__sparkle--left"
        />
        <p class="featured-products__eyebrow">{featured.eyebrow}</p>
        <div class="featured-products__heading">
          <h2 id="featured-products-title">{featured.title}</h2>
          <Image
            src={heartWatercolor}
            alt="Corazón rosa de acuarela."
            aria-hidden="true"
            width={64}
            format="webp"
            loading="lazy"
            decoding="async"
            class="featured-products__title-heart"
          />
        </div>
        <p class="featured-products__intro">{featured.intro}</p>
        <a
          class="featured-products__action"
          href={withBasePath(featured.action.href, import.meta.env.BASE_URL)}
        >
          {featured.action.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="featured-products__gallery" aria-label="Productos destacados">
        {mosaicItems.map((product) => (
          <li
            class:list={[
              'featured-products__item',
              { 'featured-products__item--primary': product.primary },
            ]}
          >
            <a
              class="featured-products__product-link"
              href={withBasePath(product.href, import.meta.env.BASE_URL)}
              aria-label={`Ver ${product.name}`}
            >
              <ResponsiveMedia media={product.media} loading="lazy" />
              <span class="featured-products__product-copy">
                <span class="featured-products__product-name">
                  {product.name}
                </span>
                <span class="featured-products__product-price">
                  {product.priceLabel}
                </span>
                <svg
                  class="featured-products__favorite"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M12 20.5S3.5 16 3.5 10c0-3.8 4.9-5.2 8.5-1 3.6-4.2 8.5-2.8 8.5 1 0 6-8.5 10.5-8.5 10.5Z" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
