---
import { routes } from '../../lib/catalog/domain/routes';
import { withBasePath, withoutBasePath } from '../../lib/site/urls';
import './favorites.css';

interface Props {
  currentPath: string;
  variant: 'desktop' | 'mobile';
}

const { currentPath, variant } = Astro.props;
const routePath = withoutBasePath(currentPath, import.meta.env.BASE_URL);
const isCurrent = routePath === routes.favorites();
---

<a
  class:list={[
    'favorites-link',
    `favorites-link--${variant}`,
    { 'site-header__mobile-action': variant === 'mobile' },
  ]}
  href={withBasePath(routes.favorites(), import.meta.env.BASE_URL)}
  aria-label="Favoritos, ninguno guardado"
  aria-current={isCurrent ? 'page' : undefined}
  data-favorites-link
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      d="M12 20S4.5 16 4.5 10.7c0-3.4 4.4-4.6 7.5-.9 3.1-3.7 7.5-2.5 7.5.9C19.5 16 12 20 12 20Z"
    ></path>
  </svg>
  <span class="favorites-link__count" data-favorites-count hidden></span>
</a>
