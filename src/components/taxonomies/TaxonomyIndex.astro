---
import type { Catalog, TaxonomyKind } from '../../lib/catalog/domain/model';
import CardList from '../patterns/CardList.astro';
import ContentSection from '../patterns/ContentSection.astro';
import TaxonomyCard from '../catalog/TaxonomyCard.astro';
import CatalogHero from '../catalog/CatalogHero.astro';
import CategoryBenefits from './CategoryBenefits.astro';
import CustomIdeaCta from '../home/CustomIdeaCta.astro';
import { catalogImageMap } from '../catalog/catalog-images';
import { buildMediaProjection } from '../catalog/media-projection';
import { catalogPageContent } from '../../content/catalog-pages';
import { routes } from '../../lib/catalog/domain/routes';
import { projectTaxonomyIndex } from './taxonomy-listing';
import Breadcrumb from '../navigation/Breadcrumb.astro';
import { taxonomyIndexBreadcrumb } from '../../lib/seo/navigation';
import './taxonomies.css';

interface Props {
  catalog: Catalog;
  kind: TaxonomyKind;
  title: string;
  intro: string;
  sectionTitle: string;
  sectionIntro: string;
  itemLabel: string;
}

const { catalog, kind, title, intro, sectionTitle, sectionIntro, itemLabel } =
  Astro.props;
const listing = projectTaxonomyIndex(catalog, kind, itemLabel);
const heroSource = listing.items.find((item) => item.mediaSource)?.mediaSource;
const heroImage = heroSource && catalogImageMap[heroSource.src];
const heroMedia =
  heroSource && heroImage
    ? await buildMediaProjection(heroImage, heroSource.alt, {
        widths: [480, 720, 960, 1200],
        sizes: '(min-width: 48rem) min(54vw, 52rem), calc(100vw - 2rem)',
      })
    : undefined;
const heroContent = catalogPageContent.taxonomy[kind];
---

<div class="taxonomies-page">
  <Breadcrumb items={taxonomyIndexBreadcrumb(kind)} />
  <CatalogHero
    eyebrow={heroContent.eyebrow}
    title={title}
    claim={heroContent.claim}
    description={intro}
    media={heroMedia}
  />
  {
    listing.items.length > 0 && (
      <ContentSection
        id={`${kind}-list`}
        title={sectionTitle}
        intro={sectionIntro}
      >
        <CardList count={listing.items.length}>
          {listing.items.map((taxonomy) => (
            <li>
              <TaxonomyCard taxonomy={taxonomy} />
            </li>
          ))}
        </CardList>
      </ContentSection>
    )
  }
  <CategoryBenefits />
  <CustomIdeaCta
    sourcePage={routes.taxonomyIndex(kind)}
    title="¿No encuentras lo que buscas?"
    copy="Cuéntanos tu idea y crearemos juntas el regalo perfecto."
  />
</div>
