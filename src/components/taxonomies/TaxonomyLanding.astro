---
import type {
  Catalog,
  Taxonomy,
  TaxonomyKind,
} from '../../lib/catalog/domain/model';
import Breadcrumb from '../navigation/Breadcrumb.astro';
import CardList from '../patterns/CardList.astro';
import ContentSection from '../patterns/ContentSection.astro';
import ProductCard from '../catalog/ProductCard.astro';
import CatalogHero from '../catalog/CatalogHero.astro';
import CategoryBenefits from './CategoryBenefits.astro';
import CustomIdeaCta from '../home/CustomIdeaCta.astro';
import { projectTaxonomyLanding } from './taxonomy-listing';
import { catalogImageMap } from '../catalog/catalog-images';
import { buildMediaProjection } from '../catalog/media-projection';
import { getProductsForTaxonomy } from '../../lib/catalog/domain/queries';
import { taxonomyBreadcrumb } from '../../lib/seo/navigation';
import type { ProductCardProjection } from '../catalog/types';
import { catalogPageContent } from '../../content/catalog-pages';
import { routes } from '../../lib/catalog/domain/routes';
import './taxonomies.css';

interface Props {
  catalog: Catalog;
  kind: TaxonomyKind;
  taxonomy: Taxonomy;
  productsTitle: string;
  productsIntro: string;
}

const { catalog, kind, taxonomy, productsTitle, productsIntro } = Astro.props;
const landing = projectTaxonomyLanding(catalog, kind, taxonomy);
const domainProducts = getProductsForTaxonomy(catalog, kind, taxonomy.id);
const heroCover = domainProducts[0]?.media.cover;
const heroImage = heroCover && catalogImageMap[heroCover.src];
const heroMedia =
  heroCover && heroImage
    ? await buildMediaProjection(heroImage, heroCover.alt, {
        widths: [480, 720, 960, 1200],
        sizes: '(min-width: 48rem) min(54vw, 52rem), calc(100vw - 2rem)',
      })
    : undefined;
const heroContent = catalogPageContent.taxonomy[kind];
const taxonomyPath = routes.taxonomy(kind, taxonomy.slug);

// Enriquecer cada product card con su media resuelta
const productsWithMedia: ProductCardProjection[] = await Promise.all(
  landing.products.map(async (item, i) => {
    const domainProduct = domainProducts[i];
    const coverSrc = domainProduct?.media?.cover?.src;
    const coverAlt = domainProduct?.media?.cover?.alt ?? '';
    const imageMetadata = coverSrc ? catalogImageMap[coverSrc] : undefined;
    return {
      ...item,
      media: imageMetadata
        ? await buildMediaProjection(imageMetadata, coverAlt)
        : undefined,
    };
  }),
);
---

<div class="taxonomy-landing">
  <Breadcrumb items={taxonomyBreadcrumb(kind, taxonomy.name)} />
  <CatalogHero
    eyebrow={heroContent.eyebrow}
    title={taxonomy.name}
    claim={heroContent.claim}
    description={taxonomy.description ?? taxonomy.summary}
    media={heroMedia}
  />
  {
    productsWithMedia.length > 0 && (
      <ContentSection
        id={`${kind}-products`}
        title={productsTitle}
        intro={productsIntro}
      >
        <CardList count={productsWithMedia.length} columns={4}>
          {productsWithMedia.map((product) => (
            <li>
              <ProductCard product={product} />
            </li>
          ))}
        </CardList>
      </ContentSection>
    )
  }
  <CategoryBenefits />
  <CustomIdeaCta sourcePage={taxonomyPath} />
</div>
