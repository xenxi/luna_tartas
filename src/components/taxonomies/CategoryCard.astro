---
import ResponsiveMedia from '../catalog/ResponsiveMedia.astro';
import type { TaxonomyCardProjection } from '../catalog/types';
import { catalogImageMap } from '../catalog/catalog-images';
import { buildMediaProjection } from '../catalog/media-projection';
import { withBasePath } from '../../lib/site/urls';

interface Props {
  taxonomy: TaxonomyCardProjection;
  actionLabel: string;
}

const { taxonomy, actionLabel } = Astro.props;
const media =
  taxonomy.media ??
  (taxonomy.mediaSource && catalogImageMap[taxonomy.mediaSource.src]
    ? await buildMediaProjection(
        catalogImageMap[taxonomy.mediaSource.src],
        taxonomy.mediaSource.alt,
        {
          widths: [320, 480, 640],
          sizes:
            '(min-width: 64rem) 20vw, (min-width: 40rem) 42vw, calc(100vw - 3rem)',
        },
      )
    : undefined);

if (!taxonomy.href.startsWith('/') || taxonomy.href.startsWith('//')) {
  throw new Error('CategoryCard requires an internal absolute-path href');
}
---

<article class="category-card">
  <span class="category-card__heart" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path
        d="M12 20S4.5 16 4.5 10.7c0-3.4 4.4-4.6 7.5-.9 3.1-3.7 7.5-2.5 7.5.9C19.5 16 12 20 12 20Z"
      ></path>
    </svg>
  </span>
  <div class="category-card__media">
    <ResponsiveMedia media={media} />
  </div>
  <div class="category-card__body">
    <h3>
      <a href={withBasePath(taxonomy.href, import.meta.env.BASE_URL)}>
        {taxonomy.name}
      </a>
    </h3>
    <p>{taxonomy.summary}</p>
    <span class="category-card__action" aria-hidden="true">
      <span>{actionLabel}</span>
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M5 12h14m-5-5 5 5-5 5"></path>
      </svg>
    </span>
  </div>
</article>
