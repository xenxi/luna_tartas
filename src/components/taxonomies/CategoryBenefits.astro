---
import { categoryIndexContent } from '../../content/category-index';
import './category-benefits.css';
---

<section class="category-benefits" aria-label="Por qué elegir Luna Tartas">
  <ul>
    {
      categoryIndexContent.benefits.map((benefit) => (
        <li>
          <span class="category-benefits__icon" aria-hidden="true">
            {benefit.icon === 'hands' && (
              <svg viewBox="0 0 40 40" focusable="false">
                <path d="M7 22v-7c0-2 3-2 3 0v5-9c0-2 3-2 3 0v8-10c0-2 3-2 3 0v10-8c0-2 3-2 3 0v11l3-3c2-2 5 1 3 3l-6 7c-2 2-4 3-7 3-5 0-9-4-9-10Z" />
                <path d="M24 29c2 2 4 3 7 3 4 0 7-3 7-7v-7c0-2-3-2-3 0v2-5c0-2-3-2-3 0v4-6c0-2-3-2-3 0v7l-2-2" />
                <path d="M21 7c1-3 5-3 6 0 1-3 5-3 6 0 0 4-6 7-6 7s-6-3-6-7Z" />
              </svg>
            )}
            {benefit.icon === 'pencil' && (
              <svg viewBox="0 0 40 40" focusable="false">
                <path d="m8 31 2-8L28 5c1-1 3-1 4 0l3 3c1 1 1 3 0 4L17 30l-9 1Z" />
                <path d="m25 8 7 7M10 23l7 7M8 31l5-5" />
              </svg>
            )}
            {benefit.icon === 'quality' && (
              <svg viewBox="0 0 40 40" focusable="false">
                <path d="m20 4 5 4 7-1 1 7 4 6-4 5-1 8-7-1-5 4-5-4-7 1-1-8-4-5 4-6 1-7 7 1 5-4Z" />
                <path d="m14 20 4 4 8-9" />
              </svg>
            )}
            {benefit.icon === 'delivery' && (
              <svg viewBox="0 0 40 40" focusable="false">
                <path d="M4 11h22v18H4zM26 18h6l5 6v5H26z" />
                <circle cx="12" cy="31" r="3" />
                <circle cx="31" cy="31" r="3" />
                <path d="M9 7h11M7 16H2" />
              </svg>
            )}
          </span>
          <span>
            <strong>{benefit.title}</strong>
            <small>{benefit.copy}</small>
          </span>
        </li>
      ))
    }
  </ul>
</section>
