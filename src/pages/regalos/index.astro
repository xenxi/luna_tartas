---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaxonomyIndex from '../../components/taxonomies/TaxonomyIndex.astro';
import { buildMediaProjection } from '../../components/catalog/media-projection';
import { loadCatalog } from '../../lib/catalog/source';
import { routes } from '../../lib/catalog/domain/routes';
import giftsHeroImage from '../../assets/gifts/gifts-hero.png';

const catalog = await loadCatalog();
const giftsHeroMedia = await buildMediaProjection(
  giftsHeroImage,
  'Regalo personalizado presentado en una bolsa decorada con flores y lazos rosas.',
  {
    widths: [480, 768, 1024, 1440, 1920],
    sizes: '(max-width: 47.99rem) 460vw, min(100vw, 93.75rem)',
  },
);
---

<BaseLayout
  title="Regalos para cada persona"
  canonicalPath={routes.taxonomyIndex('recipient')}
  fallbackDescription="Encuentra una idea personalizada para sorprender a alguien especial."
>
  <TaxonomyIndex
    catalog={catalog}
    kind="recipient"
    title="Regalos para cada persona"
    intro="Encuentra un detalle pensado para la persona especial que quieres sorprender."
    sectionTitle="Piensa en quién lo recibe"
    sectionIntro="Explora ideas de regalo según la persona con la que quieres compartir el momento."
    itemLabel="ideas"
    heroMedia={giftsHeroMedia}
    heroVariant="full-bleed"
    heroMobileObjectPosition="74% center"
  />
</BaseLayout>
