---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBasePath } from '../lib/site/urls';
---

<BaseLayout
  title="Página no encontrada"
  canonicalPath="/404/"
  robots="noindex,nofollow"
>
  <section class="container" aria-labelledby="not-found-title">
    <h1 id="not-found-title">Página no encontrada</h1>
    <p>Es posible que el enlace haya cambiado o que la página ya no exista.</p>
    <p>
      <a href={withBasePath('/', import.meta.env.BASE_URL)}>Volver al inicio</a>
    </p>
  </section>
</BaseLayout>
