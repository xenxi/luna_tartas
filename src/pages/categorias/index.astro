---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIndex from '../../components/taxonomies/CategoryIndex.astro';
import { loadCatalog } from '../../lib/catalog/source';
import { routes } from '../../lib/catalog/domain/routes';

const catalog = await loadCatalog();
---

<BaseLayout
  title="Categorías de regalos"
  canonicalPath={routes.taxonomyIndex('category')}
  fallbackDescription="Encuentra regalos personalizados según el tipo de detalle que quieres preparar."
>
  <CategoryIndex catalog={catalog} />
</BaseLayout>
