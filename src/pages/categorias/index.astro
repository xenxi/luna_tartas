---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaxonomyIndex from '../../components/taxonomies/TaxonomyIndex.astro';
import { loadCatalog } from '../../lib/catalog/source';

const catalog = await loadCatalog();
---

<BaseLayout title="Categorías de regalos">
  <TaxonomyIndex
    catalog={catalog}
    kind="category"
    title="Categorías de regalos"
    intro="Encuentra una idea especial según el tipo de detalle que quieres preparar."
    sectionTitle="Elige por tipo de regalo"
    sectionIntro="Descubre ideas agrupadas para encontrar más rápido el detalle que buscas."
    itemLabel="productos"
  />
</BaseLayout>
