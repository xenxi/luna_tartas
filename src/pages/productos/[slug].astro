---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetail from '../../components/products/ProductDetail.astro';
import ProductRelated from '../../components/products/ProductRelated.astro';
import { loadCatalog } from '../../lib/catalog/source';
import {
  getPublishedProducts,
  getPublishedTaxonomies,
} from '../../lib/catalog/domain/queries';
import { routes } from '../../lib/catalog/domain/routes';
import { catalogImageMap } from '../../components/catalog/catalog-images';

export const getStaticPaths = (async () => {
  const catalog = await loadCatalog();
  const products = getPublishedProducts(catalog);

  return products.map((product) => ({
    params: { slug: product.slug },
    props: {
      product,
      taxonomies: {
        category: getPublishedTaxonomies(catalog, 'category'),
        occasion: getPublishedTaxonomies(catalog, 'occasion'),
        recipient: getPublishedTaxonomies(catalog, 'recipient'),
      },
      catalog,
    },
  }));
}) satisfies GetStaticPaths;

const { product, taxonomies, catalog } = Astro.props;
const title = product.seo?.title ?? product.name;
const image = catalogImageMap[product.media.cover.src];

if (image === undefined) {
  throw new Error(`Missing social image for published product ${product.id}`);
}
---

<BaseLayout
  title={title}
  canonicalPath={routes.product(product.slug)}
  description={product.seo?.description}
  fallbackDescription={product.summary}
  pageType="product"
  image={{
    url: new URL(image.src, Astro.url.origin).href,
    alt: product.media.cover.alt,
  }}
>
  <ProductDetail product={product} taxonomies={taxonomies} />
  <ProductRelated catalog={catalog} product={product} />
</BaseLayout>
