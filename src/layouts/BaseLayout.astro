---
import { getCanonicalUrl, siteConfig } from '../config/site';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import '../components/site/site.css';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

if (typeof title !== 'string' || title.trim() === '') {
  throw new Error('BaseLayout requires a non-empty title');
}

const canonicalUrl = getCanonicalUrl(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter currentPath={Astro.url.pathname} />
  </body>
</html>
